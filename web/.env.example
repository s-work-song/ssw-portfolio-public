# 브라우저에 공개돼도 되는 RAG API 주소만 사용합니다.
# API 키와 모델 서버 주소는 비공개 저장소의 backend/.env에서 관리합니다.
NEXT_PUBLIC_RAG_API_BASE_URL=http://127.0.0.1:8787

# 별도 추론 게이트웨이를 배포한 뒤에만 공개 HTTPS 주소를 넣습니다.
# 비어 있으면 기존 GPT Sites 스트리밍 경로를 그대로 사용합니다.
NEXT_PUBLIC_INFERENCE_GATEWAY_URL=

# 같은 Wi-Fi의 모바일에서 next dev를 열 때 노트북 IPv4를 입력합니다.
LOCAL_DEV_IP=127.0.0.1
