{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "description": "SW Song 포트폴리오 진입 페이지 (Next.js, 정적 export)",
  "scripts": {
    "prebuild": "node scripts/vendor-mermaid.mjs",
    "build": "node scripts/next-build.mjs",
    "predev": "node scripts/vendor-mermaid.mjs",
    "dev": "next dev",
    "predev:lan": "node scripts/vendor-mermaid.mjs",
    "dev:lan": "next dev --hostname 0.0.0.0 --port 3000",
    "start": "next start",
    "serve:static": "node scripts/serve-static.mjs",
    "lint": "eslint",
    "test:webmcp": "node --test tests/features/webmcp/logViewContract.test.mjs",
    "test:chat-parse": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/features/chat/transport/sse.test.mjs",
    "test:chat-turn": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/features/chat/workflow/chatTurn.test.mjs tests/features/chat/workflow/browserToolRunner.test.mjs",
    "test:guided-tour": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/features/chat/onboarding/guidedTourNavigation.test.mjs",
    "test:chat-failure": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/features/chat/transport/chatFailure.test.mjs",
    "test:tool-navigation": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/features/chat/workflow/toolNavigationObservation.test.mjs",
    "test:chat-availability": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/features/chat/transport/chatAvailability.test.mjs",
    "test:fonts": "node --test tests/scripts/local-fonts.test.mjs",
    "test:experiments": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/features/experiments/data/agentExperiments.test.mjs tests/features/experiments/audio/experimentAudioPreview.test.mjs tests/features/portfolio-tools/experimentNavigation.test.mjs",
    "test:overview": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/features/overview/overviewPresentation.test.mjs",
    "test:deployment": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/features/architecture/data/deployment.test.mjs tests/components/diagrams/mermaidDiagram.test.mjs tests/features/architecture/ui/deploymentDiagramCarousel.test.mjs tests/features/architecture/ui/architecturePage.test.mjs tests/features/architecture/data/developmentTopology.test.mjs tests/features/architecture/data/developmentAccess.test.mjs",
    "pretest:deployment": "node scripts/vendor-mermaid.mjs",
    "test:career-turning-point": "node --test tests/features/profile/ui/careerTurningPointPreview.test.mjs",
    "test:research": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/features/research/data/research.test.mjs",
    "test:media": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/components/media/mediaSwiperPolicy.test.mjs",
    "test:dialogs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/components/media/mediaDialogPolicy.test.mjs",
    "test:log-api": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/features/logs/api/logApi.test.mjs",
    "test:log-reading": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/features/logs/detail/logReadingPosition.test.mjs tests/features/logs/navigation/logListReturn.test.mjs",
    "test:log-map": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/features/logs/map/logGraph.test.mjs tests/features/logs/map/logGraphRouting.test.mjs tests/features/logs/map/logMapState.test.mjs",
    "test:radix-controls": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/features/research/model/researchTabSelectionPolicy.test.mjs tests/features/settings/ui/radixSettings.test.mjs",
    "test:theme": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/scripts/theme.test.mjs",
    "pretest": "node scripts/vendor-mermaid.mjs",
    "test": "node scripts/run-tests.mjs",
    "pretest:all": "node scripts/vendor-mermaid.mjs",
    "test:all": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@mermaid-js/tiny": "12.1.0",
    "@noble/hashes": "2.4.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@xyflow/react": "12.12.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-cjk-friendly": "2.3.2",
    "swiper": "14.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "typescript": "^5"
  }
}
