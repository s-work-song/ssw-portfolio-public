    "test:theme": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/theme.test.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/features/webmcp/logViewContract.test.mjs src/features/chat/parse.test.mjs src/features/chat/chatFailure.test.mjs src/features/chat/chatRequestIdentity.test.mjs src/features/chat/modelHistory.test.mjs scripts/local-fonts.test.mjs scripts/theme.test.mjs src/data/agentExperiments.test.mjs src/data/research.test.mjs src/components/about/mediaSwiperPolicy.test.mjs src/components/about/mediaDialogPolicy.test.mjs src/lib/logApi.test.mjs src/components/research/researchTabSelectionPolicy.test.mjs src/app/settings/radixSettings.test.mjs src/components/about/overviewPresentation.test.mjs"
