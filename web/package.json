{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "description": "SW Song 포트폴리오 진입 페이지 (Next.js, 정적 export)",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "dev:lan": "next dev --hostname 0.0.0.0 --port 3000",
    "start": "next start",
    "serve:static": "node scripts/serve-static.mjs",
    "lint": "eslint",
    "test:webmcp": "node --test src/features/webmcp/logViewContract.test.mjs",
    "test:chat-parse": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/features/chat/parse.test.mjs",
    "test:chat-failure": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/features/chat/chatFailure.test.mjs",
    "test:chat-identity": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/features/chat/chatRequestIdentity.test.mjs",
    "test:chat-history": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/features/chat/modelHistory.test.mjs",
    "test:fonts": "node --test scripts/local-fonts.test.mjs",
    "test:experiments": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/data/agentExperiments.test.mjs",
    "test:overview": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/components/about/overviewPresentation.test.mjs",
    "test:research": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/data/research.test.mjs",
    "test:media": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/components/about/mediaSwiperPolicy.test.mjs",
    "test:dialogs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/components/about/mediaDialogPolicy.test.mjs",
    "test:log-api": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/logApi.test.mjs",
